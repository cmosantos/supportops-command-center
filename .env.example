# Safe local settings. Do not place credentials or secrets here.
SUPPORTOPS_ENVIRONMENT=local
SUPPORTOPS_LOG_LEVEL=INFO
SUPPORTOPS_LLM_ENABLED=false
SUPPORTOPS_DB_PATH=data/supportops.db
SUPPORTOPS_DB_BUSY_TIMEOUT_MS=5000
SUPPORTOPS_EXPORT_ROOT=exports
